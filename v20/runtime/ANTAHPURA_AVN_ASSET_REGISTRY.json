{
  "schema": "ANTAHPURA_AVN_ASSET_REGISTRY",
  "version": "20.0",
  "purpose": "Future AVN conversion: defines all asset hooks for characters, scenes, quests, and domains",

  "asset_categories": {
    "portraits": {
      "description": "Character portrait sets per expression",
      "variants": ["neutral", "smile", "laugh", "cry", "angry", "aroused", "blush", "trance", "subspace", "domspeace", "ritual"],
      "formats": ["png", "webp"],
      "resolution_target": "1920x1080 portrait crops",
      "per_character_required": true
    },
    "expressions": {
      "description": "Overlay sets for real-time expression shifts",
      "variants": ["eyes", "mouth", "blush", "tears", "sweat"],
      "formats": ["png_with_alpha", "spine_2d_animation"],
      "per_character_required": true
    },
    "voice": {
      "description": "Voice acting for characters",
      "variants": ["neutral_lines", "aroused_lines", "ritual_lines", "command_lines", "plea_lines"],
      "formats": ["ogg", "opus"],
      "per_character_required": true
    },
    "music_themes": {
      "description": "Musical theme per character and per scene",
      "variants": ["character_theme", "scene_ambient", "ritual_chant", "climax_stinger"],
      "formats": ["ogg"],
      "per_character_required": true
    },
    "backgrounds": {
      "description": "Location backgrounds",
      "variants": ["day", "night", "ritual_lit", "aftercare_lit"],
      "formats": ["png", "webp"],
      "per_location_required": true
    },
    "cg_scenes": {
      "description": "Illustrated scene moments",
      "variants": ["primary", "variant_a", "variant_b", "finale"],
      "formats": ["png", "webp"],
      "per_scene_template_required": true
    },
    "animations": {
      "description": "Loop animations for movement, ritual, and intimate scenes",
      "variants": ["loop", "transition_in", "transition_out"],
      "formats": ["webm", "spine_2d", "live2d"],
      "per_scene_optional": true
    },
    "ui_sheets": {
      "description": "UI elements per character and system",
      "variants": ["character_card", "dialogue_frame", "kama_icon", "kala_icon", "relationship_widget"],
      "formats": ["png", "svg"],
      "per_character_required": true
    }
  },

