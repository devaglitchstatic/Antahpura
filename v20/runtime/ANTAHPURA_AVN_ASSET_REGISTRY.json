  "ui_asset_requirements": {
    "character_card": {
      "per_character": true,
      "resolution": "512x768",
      "style": "deccan_imperial"
    },
    "dialogue_frame": {
      "variants": ["normal", "ritual", "intimate", "correction"],
      "resolution": "1920x1080",
      "style": "jali_lattice"
    },
    "kama_icon": {
      "one_per_kama": true,
      "count": 98,
      "resolution": "128x128",
      "style": "minimalist_glyph"
    },
    "kala_icon": {
      "one_per_kala": true,
      "count": 64,
      "resolution": "128x128",
      "style": "minimalist_glyph"
    },
    "relationship_widget": {
      "dimension_icons": 11,
      "resolution": "64x64",
      "style": "sanskrit_geometric"
    }
  },

  "production_pipeline": {
    "stage_1_design": {
      "outputs": ["style_guide", "character_sheets", "location_sheets"],
      "blockers": []
    },
    "stage_2_illustration": {
      "outputs": ["portraits", "expressions", "backgrounds", "cg_scenes"],
      "blockers": ["style_guide_approved"]
    },
    "stage_3_animation": {
      "outputs": ["loop_animations", "transitions"],
      "blockers": ["illustration_complete"]
    },
    "stage_4_audio": {
      "outputs": ["voice_lines", "music_tracks", "sound_effects"],
      "blockers": ["script_lock"]
    },
    "stage_5_integration": {
      "outputs": ["live2d_or_spine_rigs", "engine_asset_map"],
      "blockers": ["animation_complete", "audio_complete"]
    }
  },

  "provenance": {
    "asset_owner": "Antaḥpura constitutional council",
