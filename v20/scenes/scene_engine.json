{
  "schema": "antahpura.scene.engine",
  "version": "20.0",
  "scene_types": {
    "dialogue_scene": {
      "name": "Dialogue Scene",
      "description": "Character-driven conversation with choice points",
      "default_act_weights": {
        "act_1": 0.1,
        "act_2": 0.05,
        "act_3": 0.65,
        "act_4": 0.15,
        "act_5": 0.05
      },
      "typical_minigames": [
        "Reflection",
        "Perception"
      ],
      "typical_kala_checks": [
        "kala_voice",
        "kala_expression",
        "kala_writing"
      ]
    },
    "ritual_scene": {
      "name": "Ritual Scene",
      "description": "Formal ceremony with preparation, performance, and grounding",
      "default_act_weights": {
        "act_1": 0.15,
        "act_2": 0.25,
        "act_3": 0.35,
        "act_4": 0.15,
        "act_5": 0.1
      },
      "typical_minigames": [
        "Rhythm",
        "Reflection",
        "Perception"
      ],
      "typical_kala_checks": [
        "kala_ritual",
        "kala_mantra",
        "kala_mudra",
        "kala_yantra"
      ]
    },
    "training_scene": {
      "name": "Training Scene",
      "description": "Kala mastery progression through guided practice",
      "default_act_weights": {
        "act_1": 0.05,
        "act_2": 0.15,
        "act_3": 0.55,
        "act_4": 0.15,
        "act_5": 0.1
      },
      "typical_minigames": [
        "Endurance",
        "Coordination",
        "Sequence"
      ],
      "typical_kala_checks": [
        "all_domain_kalas"
      ]
    },
    "intimate_scene": {
      "name": "Intimate Scene",
      "description": "Kama exploration with consent, trust, and aftercare",
      "default_act_weights": {
        "act_1": 0.1,
        "act_2": 0.15,
        "act_3": 0.45,
        "act_4": 0.15,
        "act_5": 0.15
      },
      "typical_minigames": [
        "Coordination",
        "Perception",
        "Reflection"
      ],
      "typical_kala_checks": [
        "kala_maithuna",
        "kala_embrace",
        "kala_breath"
      ],
      "special_requirements": [
        "consent_verified",
        "aftercare_protocol_active",
        "risk_class_appropriate"
      ]
    },
    "conflict_scene": {
      "name": "Conflict Scene",
      "description": "Rivalry, competition, or confrontation",
      "default_act_weights": {
        "act_1": 0.1,
        "act_2": 0.1,
        "act_3": 0.55,
        "act_4": 0.15,
        "act_5": 0.1
      },
      "typical_minigames": [
        "Coordination",
        "Endurance",
        "Sequence"
      ],
      "typical_kala_checks": [
        "kala_combat",
        "kala_strategy",
        "kala_performance"
      ]
    },
    "exploration_scene": {
      "name": "Exploration Scene",
      "description": "Location discovery, secret discovery, investigation",
      "default_act_weights": {
        "act_1": 0.2,
        "act_2": 0.1,
        "act_3": 0.45,
        "act_4": 0.15,
        "act_5": 0.1
      },
      "typical_minigames": [
        "Perception",
        "Puzzle"
      ],
      "typical_kala_checks": [
        "kala_perception",
        "kala_investigation",
        "kala_stealth"
      ]
    },
    "political_scene": {
      "name": "Political Scene",
      "description": "Court intrigue, alliance negotiation, reputation management",
      "default_act_weights": {
        "act_1": 0.15,
        "act_2": 0.1,
        "act_3": 0.5,
        "act_4": 0.15,
        "act_5": 0.1
      },
      "typical_minigames": [
        "Reflection",
        "Puzzle"
      ],
      "typical_kala_checks": [
        "kala_protocol",
        "kala_voice",
        "kala_logic",
        "kala_writing"
      ]
    }
  },
  "act_structure": {
    "description": "Every scene follows a 5-act arc. Acts may be compressed or expanded based on scene type.",
    "acts": {
      "act_1_environment": {
        "name": "Spatial Consecration",
        "purpose": "Establish location, time, participants, sensory context",
        "required_fields": [
          "location_id",
          "occasion_id",
          "participants",
          "environmental_modifiers"
        ],
        "player_actions": [
          "observe",
          "engage",
          "shift"
        ]
      },
      "act_2_preparation": {
        "name": "Somatic Regulation",
        "purpose": "Characters prepare physically, emotionally, ritually",
        "required_fields": [
          "preparation_activities",
          "kala_activations",
          "kama_activations"
        ],
        "player_actions": [
          "observe",
          "engage",
          "shift"
        ]
      },
      "act_3_interaction": {
        "name": "Sonic & Geometric Resonance",
        "purpose": "Core interaction — dialogue, kala performance, kama exploration",
        "required_fields": [
          "dialogue_nodes",
          "kala_checks",
          "relationship_checks",
          "choice_points"
        ],
        "player_actions": [
          "observe",
          "engage",
          "shift"
        ]
      },
      "act_4_revelation": {
        "name": "Metaphysical Crux",
        "purpose": "Decision point — revelation, choice, consequence trigger",
        "required_fields": [
          "choice_object",
          "consequence_class",
          "visibility",
          "audience"
        ],
        "player_actions": [
          "observe",
          "engage",
          "shift"
        ]
      },
      "act_5_grounding": {
        "name": "Grounding & Dissolution",
        "purpose": "Resolution, memory write, relationship delta, recovery",
        "required_fields": [
          "memory_writes",
          "relationship_deltas",
          "recovery_type"
        ],
        "player_actions": [
          "observe",
          "engage",
          "shift"
        ]
      }
    }
  }
}