      "name": "Spatial Consecration",
      "purpose": "Establish location, time, participants, sensory context",
      "required_fields": [
        "location_id",
        "occasion_id",
        "participants",
        "environmental_modifiers"
      ],
      "player_actions": [
        "observe",
        "engage",
        "shift"
      ]
    },
    "act_2_preparation": {
      "name": "Somatic Regulation",
      "purpose": "Characters prepare physically, emotionally, ritually",
      "required_fields": [
        "preparation_activities",
        "kala_activations",
        "kama_activations"
      ],
      "player_actions": [
        "observe",
        "engage",
        "shift"
      ]
    },
    "act_3_interaction": {
      "name": "Sonic & Geometric Resonance",
