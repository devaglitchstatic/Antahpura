    "consequence_classes": {
      "description": "Five consequence classes determine the scope of choice outcomes.",
      "classes": {
        "micro": {
          "name": "Micro Consequence",
          "scope": "Affects current scene only",
          "persistence": "none",
          "typical_effects": ["dialogue_branch", "minor_relationship_delta", "scene_state_change"],
          "example": "Choosing to compliment vs. ignore a character's performance"
        },
        "personal": {
          "name": "Personal Consequence",
          "scope": "Affects character relationship",
          "persistence": "relationship_memory",
          "typical_effects": ["relationship_dimension_delta", "memory_write", "kama_curiosity_change"],
          "example": "Confiding a secret to another character"
        },
        "institutional": {
          "name": "Institutional Consequence",
          "scope": "Affects office/faction standing",
          "persistence": "institutional_reputation",
          "typical_effects": ["institutional_reputation_delta", "access_permission_change", "office_standing_change"],
          "example": "Publicly challenging a protocol decision"
        },
        "narrative": {
          "name": "Narrative Consequence",
          "scope": "Changes future chapters",
          "persistence": "quest_state_change",
          "typical_effects": ["quest_unlock", "scene_availability_change", "chapter_branch"],
          "example": "Choosing to ally with one faction over another"
        },
        "canonical": {
          "name": "Canonical Consequence",
          "scope": "Extremely rare; changes world history",
          "persistence": "canon_update",
          "typical_effects": ["canon_decision_record", "world_state_change", "permanent_unlock"],
          "example": "A decision that alters the succession line or redefines an institution"
        }
      }
    },

    "consequence_severity_ladder": {
      "description": "Within each consequence class, severity determines magnitude.",
      "levels": {
