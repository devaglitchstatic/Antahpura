        "minor": {"multiplier": 0.5, "memory_salience": 0.3, "persists": false},
        "moderate": {"multiplier": 1.0, "memory_salience": 0.5, "persists": true},
        "major": {"multiplier": 1.5, "memory_salience": 0.7, "persists": true},
        "severe": {"multiplier": 2.0, "memory_salience": 0.9, "persists": true},
        "transformative": {"multiplier": 3.0, "memory_salience": 1.0, "persists": true, "canon_impact": true}
      }
